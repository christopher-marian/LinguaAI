# LinguaAI Environment Variables Template

# Backend Settings
SECRET_KEY=replace-with-a-secure-secret
DATABASE_URL=sqlite:///./lingua_ai.db

# OpenAI API Key (Optional)
# If provided, LinguaAI connects directly to OpenAI services.
# If omitted, LinguaAI seamlessly operates on an intelligent mock/fallback service.
# OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Frontend Settings
VITE_API_URL=http://127.0.0.1:8000
